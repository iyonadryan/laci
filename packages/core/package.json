{
  "name": "@lacijs/core",
  "version": "0.0.0",
  "description": "Editable runtime configuration: configs, email templates, and message templates stored in your database, validated with JSON Schema.",
  "license": "MIT",
  "author": "Iyon",
  "homepage": "https://github.com/iyonadryan/laci/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyonadryan/laci.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/iyonadryan/laci/issues"
  },
  "keywords": [
    "config",
    "configuration",
    "runtime-config",
    "feature-flags",
    "email-templates",
    "message-templates",
    "json-schema",
    "laci"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "liquidjs": "^10.30.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
